# Copy this file to .env. Never commit or share .env.

# Required. A long random key: anyone holding it can control your toy.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TOY_HUB_TOKEN=

# Where the server listens. Keep 127.0.0.1 behind an HTTPS reverse proxy or tunnel.
HOST=127.0.0.1
PORT=3737

# Optional: enable ChatGPT OAuth on this public HTTPS origin. No path or secret.
# TOY_HUB_PUBLIC_URL=https://toyhub.example.com

# Optional: your AI's voice (toy_speak) and hold-to-talk transcription.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_v4
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# Optional: where saved replays, toy names and voice clips are stored. Defaults to ./data
# TOY_HUB_DATA=
